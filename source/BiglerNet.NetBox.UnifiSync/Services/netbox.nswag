rue\r\n                    },\r\n                    \"display_url\": {\r\n                        \"type\": \"string\",\r\n                        \"format\": \"uri\",\r\n                        \"readOnly\": true\r\n                    },\r\n                    \"display\": {\r\n                        \"type\": \"string\",\r\n                        \"readOnly\": true\r\n                    },\r\n                    \"name\": {\r\n                        \"type\": \"string\",\r\n                        \"maxLength\": 100\r\n                    },\r\n                    \"slug\": {\r\n                        \"type\": \"string\",\r\n                        \"maxLength\": 100,\r\n                        \"pattern\": \"^[-a-zA-Z0-9_]+$\"\r\n                    },\r\n                    \"description\": {\r\n                        \"type\": \"string\",\r\n                        \"maxLength\": 200\r\n                    },\r\n                    \"tags\": {\r\n                        \"type\": \"array\",\r\n                        \"items\": {\r\n                            \"$ref\": \"#/components/schemas/NestedTag\"\r\n                        }\r\n                    },\r\n                    \"custom_fields\": {\r\n                        \"type\": \"object\",\r\n                        \"additionalProperties\": {}\r\n                    },\r\n                    \"created\": {\r\n                        \"type\": \"string\",\r\n                        \"format\": \"date-time\",\r\n                        \"readOnly\": true,\r\n                        \"nullable\": true\r\n                    },\r\n                    \"last_updated\": {\r\n                        \"type\": \"string\",\r\n                        \"format\": \"date-time\",\r\n                        \"readOnly\": true,\r\n                        \"nullable\": true\r\n                    }\r\n                },\r\n                \"required\": [\r\n                    \"created\",\r\n              